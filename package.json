{
  "name": "divia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:codespaces": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "wrangler:dev": "wrangler dev",
    "wrangler:deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute divia-prod --file ./src/db/schema.sql",
    "db:seed": "wrangler d1 execute divia-prod --file ./src/db/seed.sql"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20230704.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^10.16.0",
    "hls.js": "^1.4.0",
    "itty-router": "^5.0.22",
    "jsonwebtoken": "^9.0.2",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "react-mic": "^12.4.0",
    "wavesurfer.js": "^6.6.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.1",
    "@types/hls.js": "^0.7.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.2.0",
    "wrangler": "^3.11.0"
  }
}
